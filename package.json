{
  "name": "nodejs-demo-app",
  "version": "1.0.0",
  "description": "A production-ready Node.js Express application with CI/CD pipeline using GitHub Actions and Docker",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint src/ tests/"
  },
  "keywords": [
    "nodejs",
    "express",
    "docker",
    "github-actions",
    "cicd",
    "devops"
  ],
  "author": "Himanshu",
  "license": "MIT",
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.22.3"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
